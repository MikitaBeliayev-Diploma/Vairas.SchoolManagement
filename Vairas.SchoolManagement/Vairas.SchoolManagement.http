# Replace synthetic IDs with authorized resources. Tokens come only from your process environment.
# Every write has a distinct stable example key; retry the identical request/key. Use a new key for new intent.
@baseUrl = https://localhost:7200
@userToken = {{$processEnv VAIRAS_USER_TOKEN}}
@workloadToken = {{$processEnv VAIRAS_WORKLOAD_TOKEN}}
@schoolId = 10000000-0000-4000-8000-000000000001
@branchId = 10000000-0000-4000-8000-000000000002
@groupId = 10000000-0000-4000-8000-000000000003
@enrollmentId = 10000000-0000-4000-8000-000000000004
@invitationId = 10000000-0000-4000-8000-000000000005
@membershipId = 10000000-0000-4000-8000-000000000006
@studentId = 10000000-0000-4000-8000-000000000007
@teacherId = 10000000-0000-4000-8000-000000000008
@programVersionId = 10000000-0000-4000-8000-000000000009
@targetUserId = 10000000-0000-4000-8000-000000000010

### validateProfileProvisioning
POST {{baseUrl}}/internal/v1/profile-provisioning/validate
Authorization: Bearer {{workloadToken}}
X-Correlation-ID: school-example-1
Idempotency-Key: 20000000-0000-4000-8000-000000000001
Content-Type: application/json

{
  "actorUserId": "{{targetUserId}}",
  "targetUserId": "{{targetUserId}}",
  "schoolId": "{{schoolId}}",
  "invitationId": "{{invitationId}}",
  "role": "Teacher",
  "bootstrap": false
}

### checkEnrollmentEligibility
GET {{baseUrl}}/internal/v1/enrollments/{{enrollmentId}}/eligibility?schoolId={{schoolId}}&actingUserId={{targetUserId}}&teacherId={{teacherId}}
Authorization: Bearer {{workloadToken}}
X-Correlation-ID: school-example-2

### getGroupParticipants
GET {{baseUrl}}/internal/v1/groups/{{groupId}}/participants?schoolId={{schoolId}}&membershipRevision=1&from=2026-12-01T10%3A00%3A00Z&to=2026-12-01T11%3A00%3A00Z
Authorization: Bearer {{workloadToken}}
X-Correlation-ID: school-example-3

### issueInvitation
POST {{baseUrl}}/api/v1/schools/{{schoolId}}/invitations
Authorization: Bearer {{userToken}}
X-Correlation-ID: school-example-4
Idempotency-Key: 20000000-0000-4000-8000-000000000004
Content-Type: application/json

{
  "targetUserId": "{{targetUserId}}",
  "role": "Teacher"
}

### getInvitation
GET {{baseUrl}}/api/v1/schools/{{schoolId}}/invitations/{{invitationId}}
Authorization: Bearer {{userToken}}
X-Correlation-ID: school-example-5

### acceptInvitation
POST {{baseUrl}}/api/v1/schools/{{schoolId}}/invitations/{{invitationId}}/accept
Authorization: Bearer {{userToken}}
X-Correlation-ID: school-example-6
Idempotency-Key: 20000000-0000-4000-8000-000000000006
Content-Type: application/json

{
  "expectedRevision": 1
}

### revokeInvitation
POST {{baseUrl}}/api/v1/schools/{{schoolId}}/invitations/{{invitationId}}/revoke
Authorization: Bearer {{userToken}}
X-Correlation-ID: school-example-7
Idempotency-Key: 20000000-0000-4000-8000-000000000007
Content-Type: application/json

{
  "expectedRevision": 1,
  "reason": "Invitation withdrawn"
}

### getMyInvitations
GET {{baseUrl}}/api/v1/users/me/invitations?limit=20
Authorization: Bearer {{userToken}}
X-Correlation-ID: school-example-8

### getMyEnrollments
GET {{baseUrl}}/api/v1/users/me/enrollments
Authorization: Bearer {{userToken}}
X-Correlation-ID: school-example-9

### getSchool
GET {{baseUrl}}/api/v1/schools/{{schoolId}}
Authorization: Bearer {{userToken}}
X-Correlation-ID: school-example-10

### renameSchool
PATCH {{baseUrl}}/api/v1/schools/{{schoolId}}/name
Authorization: Bearer {{userToken}}
X-Correlation-ID: school-example-11
Idempotency-Key: 20000000-0000-4000-8000-000000000011
Content-Type: application/json

{
  "expectedRevision": 1,
  "name": "School display name"
}

### listBranches
GET {{baseUrl}}/api/v1/schools/{{schoolId}}/branches
Authorization: Bearer {{userToken}}
X-Correlation-ID: school-example-12

### createBranch
POST {{baseUrl}}/api/v1/schools/{{schoolId}}/branches
Authorization: Bearer {{userToken}}
X-Correlation-ID: school-example-13
Idempotency-Key: 20000000-0000-4000-8000-000000000013
Content-Type: application/json

{
  "name": "Main branch",
  "addressLine": "Synthetic address",
  "city": "Vilnius",
  "postalCode": null,
  "countryCode": "LT"
}

### getBranch
GET {{baseUrl}}/api/v1/schools/{{schoolId}}/branches/{{branchId}}
Authorization: Bearer {{userToken}}
X-Correlation-ID: school-example-14

### updateBranch
PUT {{baseUrl}}/api/v1/schools/{{schoolId}}/branches/{{branchId}}
Authorization: Bearer {{userToken}}
X-Correlation-ID: school-example-15
Idempotency-Key: 20000000-0000-4000-8000-000000000015
Content-Type: application/json

{
  "expectedRevision": 1,
  "name": "Updated branch",
  "addressLine": null,
  "city": "Vilnius",
  "postalCode": null,
  "countryCode": "LT"
}

