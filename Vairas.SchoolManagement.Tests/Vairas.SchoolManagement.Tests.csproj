<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableServiceIntegrationTests Condition="'$(EnableServiceIntegrationTests)' == '' and Exists('../../Vairas.Authentication/Vairas.Authentication/Vairas.Authentication.csproj') and Exists('../../Vairas.UserManagement/Vairas.UserManagement/Vairas.UserManagement.csproj')">true</EnableServiceIntegrationTests>
    <EnableServiceIntegrationTests Condition="'$(EnableServiceIntegrationTests)' == ''">false</EnableServiceIntegrationTests>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Vairas.SchoolManagement/Vairas.SchoolManagement.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15"  />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1"  />
    <PackageReference Include="NUnit" Version="4.4.0"  />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1"  />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.17.0"  />
    <PackageReference Include="Moq" Version="4.20.72"  />
    <PackageReference Include="coverlet.collector" Version="6.0.4" PrivateAssets="all" />
    <ProjectReference Include="../../Vairas.Authentication/Vairas.Authentication/Vairas.Authentication.csproj" Aliases="Authentication" Condition="'$(EnableServiceIntegrationTests)' == 'true'" />
    <ProjectReference Include="../../Vairas.UserManagement/Vairas.UserManagement/Vairas.UserManagement.csproj" Aliases="UserManagement" Condition="'$(EnableServiceIntegrationTests)' == 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableServiceIntegrationTests)' != 'true'">
    <Compile Remove="IntegrationEnvironment.cs;SchoolIntegrationTests.cs;TestUser.cs;ConfiguredFactory.cs" />
  </ItemGroup>
</Project>
